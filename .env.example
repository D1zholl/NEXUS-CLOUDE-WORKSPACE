# NEXUS WORKSPACE — пример переменных окружения.
# Скопируйте в .env (не коммитится) или задайте переменные в системе.

# Обязательно: строка подключения PostgreSQL
DATABASE_URL=postgres://nexus:nexus@127.0.0.1:5432/nexus

# Секрет для подписи CSRF-токенов (>= 32 случайных байта в hex).
# Сгенерировать: openssl rand -hex 32
NEXUS_SECRET=change-me-please-change-me-please-change-me

# Переопределения конфигурации nexus.toml
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8080
NEXUS_PUBLIC_URL=http://localhost:8080
NEXUS_COOKIE_SECURE=false
NEXUS_STATIC_DIR=frontend/dist
NEXUS_CORS_ORIGINS=
# Минимальная длина пароля для CLI (8–64). API читает значение из system_settings.
NEXUS_PASSWORD_MIN_LENGTH=12
# true — только за доверенным reverse proxy (иначе IP клиента подделывается).
NEXUS_TRUST_PROXY=false

# Swagger UI /api/v1/docs. По умолчанию выключен (404); включайте для разработки.
NEXUS_ENABLE_DOCS=false

# Журнал в файл: пусто — вывод только в stderr. При старте файл ротируется,
# хранится NEXUS_LOG_KEEP архивов.
NEXUS_LOG_DIR=
NEXUS_LOG_FILE=nexus.log
NEXUS_LOG_KEEP=7

# Уровень логирования
RUST_LOG=nexus=info,tower_http=info,sqlx=warn

# NEXUS AI Workspace
# AI-модуль, Provider, Runtime, Skills, квоты и политики инструментов настраиваются
# в System Management → AI Management и хранятся в PostgreSQL. Отдельных
# production-секретов в .env не требуется: device token Runtime выдаётся при
# enrollment, API key провайдера шифруется ключом, производным от NEXUS_SECRET.
# При смене NEXUS_SECRET сохранённые API key потребуется ввести повторно.
