# NEXUS WORKSPACE — справочник переменных окружения Standalone.
#
# В обычном режиме лаунчер передаёт эти значения backend сам:
#   DATABASE_URL, NEXUS_SECRET, NEXUS_CONFIG, NEXUS_HOST, NEXUS_PORT,
#   NEXUS_PUBLIC_URL, NEXUS_STATIC_DIR, NEXUS_LOG_DIR, NEXUS_LOG_FILE,
#   NEXUS_SHUTDOWN_FILE.
# Секреты находятся в config/secrets.json (ограниченный ACL) и НЕ должны
# дублироваться в этом файле.
#
# Этот файл — только документация. Не переименовывайте его в .env:
# лаунчер не читает .env и не требует ручной настройки.

NEXUS_HOST=127.0.0.1
NEXUS_PORT=8080
NEXUS_PUBLIC_URL=http://127.0.0.1:8080
NEXUS_COOKIE_SECURE=false
NEXUS_TRUST_PROXY=false
NEXUS_CORS_ORIGINS=
NEXUS_PASSWORD_MIN_LENGTH=12
NEXUS_LOG_FILE=backend.log
NEXUS_LOG_KEEP=14
RUST_LOG=nexus=info,tower_http=info,sqlx=warn

# Только при явном внешнем reverse proxy с HTTPS:
# NEXUS_COOKIE_SECURE=true
# NEXUS_TRUST_PROXY=true
# NEXUS_CORS_ORIGINS=https://nexus.example.com

# Документация API (по умолчанию выключена):
# NEXUS_ENABLE_DOCS=false
