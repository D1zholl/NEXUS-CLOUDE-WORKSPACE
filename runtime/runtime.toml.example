# NEXUS AI Runtime — пример конфигурации.
# Скопируйте в C:\NexusAI\runtime.toml и заполните значения.
# Секреты (device token) хранятся отдельно в state\device.json и не входят в этот файл.

[server]
# Production: wss://nexus.example.com/api/v1/ai/runtime/connect
url = "wss://nexus.example.com/api/v1/ai/runtime/connect"
# Для enrollment: https://nexus.example.com
enroll_url = "https://nexus.example.com"
name = "AI-WORKSTATION"
# Разрешить ws:// только для локальной отладки.
allow_insecure_ws = false
heartbeat_seconds = 20
reconnect_min_seconds = 2
reconnect_max_seconds = 60

[storage]
state_dir = "C:\\NexusAI\\state"
token_file = "device.json"
receipts_file = "receipts.jsonl"
# Ротация receipts: текущий сегмент, лимит сегментов и глубина загрузки.
# Удаляются только самые старые сегменты; это безопасно, потому что Backend не
# переотправляет завершённые команды (`completed`/`failed`).
receipts_max_bytes = 10485760
receipts_max_archives = 16
receipts_load_limit = 5000
# Workspace, созданные администратором, обязаны находиться внутри этих корней.
allowed_roots = ["C:\\NexusAI\\workspaces"]
# Каталог, в котором Runtime создаёт новые workspace по команде backend.
# Пусто — первый allowed_root (но не сам корень). Имя каталога — UUID.
provisioning_root = "C:\\NexusAI\\workspaces"
log_dir = "C:\\NexusAI\\logs"

[provider]
# PolyStrata запущена на этом же компьютере.
base_url = "http://127.0.0.1:8080/v1"
api_key = ""
timeout_seconds = 180
connect_timeout_seconds = 10

[limits]
max_parallel_tasks = 4
max_tool_output_bytes = 262144
max_file_bytes = 16777216
max_search_files = 2000
max_search_results = 200
max_directory_entries = 1000
default_tool_timeout_seconds = 120
# Снимки файлов для diff/отката: лимиты на файл, на операцию и число файлов.
snapshot_max_bytes = 262144
snapshot_max_total_bytes = 2097152
snapshot_max_files = 100
skip_directories = [".git", "node_modules", "target", "dist", ".venv", "__pycache__"]

[logging]
level = "info"
keep_files = 14

# Программы, которые разрешено запускать агенту. Модель не может добавить
# программу или сформировать shell-команду: executable берётся только отсюда.
# Укажите реальные пути на этом компьютере.

[[programs]]
program_id = "git"
name = "Git"
executable = "C:\\Program Files\\Git\\cmd\\git.exe"
version = "2.x"
risk = "high"
allow_any_args = false
arg_patterns = ["^[A-Za-z0-9._/\\\\:-]{1,250}$"]
timeout_seconds = 120
max_output_bytes = 131072

[[programs]]
program_id = "python"
name = "Python"
executable = "C:\\Python312\\python.exe"
version = "3.12"
risk = "high"
allow_any_args = false
arg_patterns = ["^[A-Za-z0-9._/\\\\-]{1,250}$"]
timeout_seconds = 300
max_output_bytes = 262144
# deny (по умолчанию) — Runtime временно блокирует outbound-сеть процесса.
# Требует прав администратора; без них запуск отклоняется (fail closed).
network_policy = "deny"
# Лимит памяти процесса в байтах (0 — без лимита).
max_memory_bytes = 0

[[programs]]
program_id = "node"
name = "Node.js"
executable = "C:\\Program Files\\nodejs\\node.exe"
version = "22.x"
risk = "high"
allow_any_args = false
arg_patterns = ["^[A-Za-z0-9._/\\\\-]{1,250}$"]
timeout_seconds = 300
max_output_bytes = 262144

[[programs]]
program_id = "npm"
name = "npm"
executable = "C:\\Program Files\\nodejs\\npm.cmd"
version = "11.x"
risk = "high"
allow_any_args = false
arg_patterns = ["^[A-Za-z0-9._/\\\\-]{1,250}$"]
timeout_seconds = 300
max_output_bytes = 262144

[[programs]]
program_id = "cargo"
name = "Rust Cargo"
executable = "C:\\Tools\\cargo\\bin\\cargo.exe"
version = "1.x"
risk = "high"
allow_any_args = false
arg_patterns = ["^[A-Za-z0-9._:-]{1,200}$"]
timeout_seconds = 600
max_output_bytes = 262144

[[programs]]
program_id = "powershell"
name = "PowerShell (только -File)"
executable = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
version = "5.1"
risk = "critical"
allow_any_args = false
# -Command/-EncodedCommand намеренно не разрешены.
arg_patterns = [
  "^-NoProfile$",
  "^-NonInteractive$",
  "^-ExecutionPolicy$",
  "^RemoteSigned$",
  "^-File$",
  "^[A-Za-z0-9._/][A-Za-z0-9._/\\\\-]{0,199}$"
]
timeout_seconds = 600
max_output_bytes = 262144

[[programs]]
program_id = "ffmpeg"
name = "FFmpeg"
executable = "C:\\ffmpeg\\bin\\ffmpeg.exe"
version = "7.x"
risk = "high"
allow_any_args = false
arg_patterns = ["^[A-Za-z0-9._/\\\\:-]{1,250}$"]
timeout_seconds = 600
max_output_bytes = 262144

[[programs]]
program_id = "playwright"
name = "Playwright"
executable = "C:\\Program Files\\nodejs\\npx.cmd"
version = "1.x"
risk = "critical"
allow_any_args = false
arg_patterns = ["^[A-Za-z0-9._:-]{1,200}$"]
timeout_seconds = 900
max_output_bytes = 262144
