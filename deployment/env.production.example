# NEXUS WORKSPACE — пример production-окружения.
# Скопируйте в .env рядом с исполняемым файлом и заполните значения.

# Обязательно: строка подключения PostgreSQL.
# PostgreSQL должен слушать только localhost или приватную сеть.
DATABASE_URL=postgres://nexus:CHANGE_ME@127.0.0.1:5432/nexus

# Обязательно: не менее 32 случайных символов.
# Сгенерировать: openssl rand -hex 32
NEXUS_SECRET=CHANGE_ME_TO_A_RANDOM_64_HEX_STRING

NEXUS_HOST=127.0.0.1
NEXUS_PORT=8080
NEXUS_PUBLIC_URL=https://nexus.example.com
NEXUS_COOKIE_SECURE=true
NEXUS_STATIC_DIR=../frontend/dist
NEXUS_CORS_ORIGINS=
# Минимальная длина пароля для CLI (8–64). API читает значение из system_settings.
NEXUS_PASSWORD_MIN_LENGTH=12

# Журнал в файл (для службы Windows).
NEXUS_LOG_DIR=./logs
NEXUS_LOG_FILE=nexus.log
NEXUS_LOG_KEEP=7

# Лимиты Launcher API (необязательно; по умолчанию 120 / 600 / 8).
# Для службы Windows задавайте их в этом .env или в переменных среды УРОВНЯ
# МАШИНЫ: служба не наследует переменные, заданные через setx в сессии
# пользователя. Проверка: nexus.exe check (строка «лимиты лаунчера»).
# NEXUS_LAUNCHER_RPM=120
# NEXUS_LAUNCHER_ARTIFACTS_RPM=600

RUST_LOG=nexus=info,tower_http=warn,sqlx=warn
# Swagger UI на /api/v1/docs. Не включайте его в production.
NEXUS_ENABLE_DOCS=false
